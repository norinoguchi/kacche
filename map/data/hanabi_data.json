  "spotContentI18n": {
    "3001": {
      "ja": {
        "title": "長岡まつり大花火大会",
        "location": "新潟県長岡市",
        "desc": "信濃川河川敷で開催される日本三大花火大会の一つ。視界を埋め尽くす超大型スターマイン「フェニックス」は圧巻。"
      },
      "en": {
        "title": "Nagaoka Festival Fireworks Festival",
        "location": "Nagaoka City, Niigata Prefecture",
        "desc": "One of Japan's three major fireworks festivals held on the Shinano River riverbed. The super large star mine \"Phoenix\" that fills the field of view is a masterpiece."
      },
      "zh-TW": {
        "title": "長岡祭煙火大會",
        "location": "新潟縣長岡市",
        "desc": "日本三大花火大會之一，在信濃川河床舉行。充滿視野的超大型星礦「鳳凰」堪稱傑作。"
      },
      "zh-CN": {
        "title": "长冈祭烟火大会",
        "location": "新泻县长冈市",
        "desc": "日本三大花火大会之一，在信浓川河床举行。充满视野的超大型星矿“凤凰”堪称杰作。"
      },
      "ko": {
        "title": "나가오카 축제 큰 불꽃 놀이",
        "location": "니가타현 나가오카시",
        "desc": "시나노가와 하천 부지에서 개최되는 일본 3대 불꽃놀이 중 하나. 시야를 가득 채우는 초대형 스타 마인 「피닉스」는 압권."
      },
      "th": {
        "title": "เทศกาลดอกไม้ไฟนางาโอกะ",
        "location": "เมืองนางาโอกะ จังหวัดนีงะตะ",
        "desc": "หนึ่งในสามเทศกาลดอกไม้ไฟที่สำคัญของญี่ปุ่นที่จัดขึ้นบริเวณก้นแม่น้ำชินาโนะ เหมืองดาวขนาดใหญ่พิเศษ \"ฟีนิกซ์\" ที่เติมเต็มขอบเขตการมองเห็นถือเป็นผลงานชิ้นเอก"
      },
      "id": {
        "title": "Festival Kembang Api Festival Nagaoka",
        "location": "Kota Nagaoka, Prefektur Niigata",
        "desc": "Salah satu dari tiga festival kembang api besar di Jepang yang diadakan di dasar sungai Shinano. Tambang bintang super besar \"Phoenix\" yang memenuhi bidang pandang adalah sebuah mahakarya."
      }
    },
    "3002": {
      "ja": {
        "title": "全国花火競技大会（大曲の花火）",
        "location": "秋田県大仙市",
        "desc": "全国から選ばれた花火師たちが技術を競い合う日本最高峰の花火競技大会。"
      },
      "en": {
        "title": "Omagari Fireworks Competition",
        "location": "Daisen City, Akita",
        "desc": "Japan's top fireworks competition where elite pyrotechnicians compete for the Prime Minister's Prize."
      }
    },
    "3003": {
      "ja": {
        "title": "土浦全国花火競技大会",
        "location": "茨城県土浦市",
        "desc": "秋に開催される伝統の競技花火大会。スターマインの部や創作花火など見どころ満載。"
      },
      "en": {
        "title": "Tsuchiura All-Japan Fireworks Competition",
        "location": "Tsuchiura City, Ibaraki",
        "desc": "A prestigious autumn fireworks competition known for high-speed Star Mines."
      }
    },
    "3004": {
      "ja": {
        "title": "隅田川花火大会",
        "location": "東京都台東区・墨田区",
        "desc": "江戸時代からの伝統を誇る東京の夏風物詩。スカイツリーと花火の競演を楽しめます。"
      },
      "en": {
        "title": "Sumidagawa Fireworks Festival",
        "location": "Taito & Sumida Wards, Tokyo",
        "desc": "Tokyo's iconic traditional fireworks festival dating back to the Edo period with Skytree views."
      }
